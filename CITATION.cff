title: "Nirmata: Trajectory-Aware Evaluation and Delegated Authority for AI Agents"
type: software
authors:
  - family-names: Jahoda
    given-names: Tabata
    orcid: "https://orcid.org/0009-0007-1104-9204"
version: 0.1.0
date-released: 2026-08-27
